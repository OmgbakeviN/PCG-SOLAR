# URL publique de la Neon Function PCG Solar API.
# Ne mets jamais DATABASE_URL ou un mot de passe PostgreSQL dans le frontend.
VITE_API_URL=https://YOUR-NEON-FUNCTION-URL

# Endpoint public Neon Auth de la branche utilisée par le frontend.
VITE_NEON_AUTH_URL=https://YOUR-NEON-AUTH-URL

# TEMPORAIRE : active /admin/setup uniquement pour créer le premier compte admin.
# Après création + ajout dans public.admin_users, repasse à false et redémarre Vite.
VITE_ENABLE_ADMIN_SETUP=false
